async def verify_observation(self, observation: PassiveObservation) -> Optional[Finding]:
    # Secret Filter Hook: Filter out PASS-003 false-positive secret leaks
    if observation.plugin_id == "PASS-003" or observation.observation_type == "secret_exposure":
        from ..passive.plugins.info_disclosure import SecretValidator
        endpoint_host = urllib.parse.urlparse(observation.endpoint).netloc.split(":")[0].lower()

        # Domain Whitelisting for Major Public Platforms (YouTube, Facebook, Instagram, etc.)
        if any(dom in endpoint_host for dom in SecretValidator.PUBLIC_PLATFORM_DOMAINS):
            if not any(crit in observation.title for crit in ["AWS Access Key ID", "RSA Private Key", "Stripe Live Secret"]):
                return None # Drop false positive secret disclosure

